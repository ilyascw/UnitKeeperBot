# PostgreSQL
POSTGRES_USER=unitkeeper
POSTGRES_PASSWORD=unitkeeper
POSTGRES_DB=unitkeeper
DATABASE_URL=postgresql+asyncpg://unitkeeper:unitkeeper@db:5432/unitkeeper

# Backend
APP_ENV=production
SQLALCHEMY_ECHO=false
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=86400
INTERNAL_BOT_SECRET=replace-with-another-random-secret
DEFAULT_TIMEZONE=UTC

# Telegram bot process
UNITKEEPER_BOT_TOKEN=replace-with-bot-token
UNITKEEPER_BACKEND_BASE_URL=http://backend:8000/api/v1
UNITKEEPER_INTERNAL_BOT_SECRET=replace-with-another-random-secret
UNITKEEPER_MINIAPP_URL=https://unitkeeper.example.com
UNITKEEPER_REQUEST_TIMEOUT_SECONDS=10
