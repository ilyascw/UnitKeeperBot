# Base URL of the UnitKeeper backend API (includes the /api/v1 prefix).
# Local backend default:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Enable verbose Telegram SDK logging in development.
VITE_TELEGRAM_DEBUG=false

# Development-only escape hatch.
# When the app runs outside Telegram (a plain browser tab) there is no
# window.Telegram.WebApp, so init data cannot be retrieved. Paste a raw
# initData string here to bootstrap auth during local development.
# Leave empty in production builds.
VITE_DEV_INIT_DATA=
